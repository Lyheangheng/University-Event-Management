# ==============================================================================
# University Event Management System — Environment Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL TIMESTAMPTZ UTC)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=university_event_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/university_event_db?schema=public"

# API Backend Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Storage Provider Configuration ("local" for development, "s3" for production cloud object storage)
STORAGE_PROVIDER="local"
S3_BUCKET="university-event-proofs"
S3_REGION="ap-southeast-1"
S3_ACCESS_KEY_ID="your-production-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-production-s3-secret-access-key"
S3_ENDPOINT="" # Optional custom S3 endpoint URL (e.g. Cloudflare R2 / MinIO / DigitalOcean)

# Production Admin Account Bootstrapping (Unsupplied values default to dev credentials)
ADMIN_INIT_USERNAME="admin"
ADMIN_INIT_PASSWORD="your-secure-production-admin-password"

# JWT Authentication Configuration
JWT_SECRET="your-development-jwt-secret-key-here"
JWT_EXPIRES_IN="1d"

# Web Frontend Configuration (Client-side exposed parameters)
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_LIFF_ID="your-line-liff-id-here"

# LINE Official Account & Messaging API Configuration
LINE_CHANNEL_ID="your-line-channel-id-here"
LINE_CHANNEL_SECRET="your-line-channel-secret-here"
LINE_CHANNEL_ACCESS_TOKEN="your-line-channel-access-token-here"
